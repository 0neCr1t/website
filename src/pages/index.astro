---
// Static by default under `output: "static"`.
// To make this route server-rendered on demand instead, add: export const prerender = false;

import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const { title, description, heading, noindex } = (await getEntry("pages", "index")).data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
    <main>
        <h1>{heading}</h1>
        <!-- TODO: build the home page -->
    </main>
</BaseLayout>
