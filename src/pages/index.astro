---
// Static by default under `output: "static"`.
// To make this route server-rendered on demand instead, add: export const prerender = false;

import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Index from "../components/pages/Index.astro";

const { title, description, heading, noindex, shortcuts } = (await getEntry("pages", "index")).data;
---

<BaseLayout title={title} description={description} noindex={noindex}>
    <Index heading={heading ?? title} shortcuts={shortcuts} />
</BaseLayout>
